{
  "name": "wms-sim-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "小型智能仓储库位分配仿真系统 前端（Vue 3 + TypeScript + Vite + Pinia + Vue Router）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node scripts/preview-server.mjs 4173",
    "type-check": "vue-tsc --build --force tsconfig.app.json tsconfig.node.json",
    "verify:integration": "node scripts/verify-frontend-integration.mjs",
    "lint": "eslint . --ext .vue,.ts --max-warnings 0",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.4",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.11.1",
    "eslint-plugin-vue": "^9.29.0",
    "prettier": "^3.3.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.8",
    "vue-tsc": "^2.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
